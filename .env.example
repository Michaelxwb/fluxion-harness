# Local dev defaults
FLUXION_ENV=dev
FLUXION_DATABASE_URL=sqlite+aiosqlite:///./.data/fluxion.db
# Generate a 32-byte random key and provide it outside source control.
FLUXION_MASTER_KEY=
FLUXION_LOG_LEVEL=INFO

# Production examples (do not commit real credentials)
# FLUXION_DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/fluxion
# FLUXION_REDIS_URL=redis://redis:6379/0
