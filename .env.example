# Fluxion 共享启动配置：`SharedSettings` 的完整环境契约。
# 键集与 `packages/common/src/muad_common/settings.py` 的 SharedSettings 字段一一对应
# （键名 = 字段名大写），E-09 机检逐键比对；新增字段必须在此补上，否则运维无从配置。
# 平台**业务**默认（口令策略、压缩预算、任务默认、IM 展示节拍等）已迁到「系统设置」，
# 不再由环境注入；此处只留进程启动即固定、按部署单元给出的环境项。
ENV=dev
LOG_DIR=./.data/logs
LOG_LEVEL=INFO
API_MESSAGES_FILE=./config/api-messages.yaml
DEFAULT_TENANT_ID=default

DATABASE_URL=postgresql+asyncpg://muad:change-me@postgres.example.internal:5432/muad
REDIS_URL=redis://redis.example.internal:6379/0
# standalone（默认）或 cluster；cluster 时 REDIS_URL 为主 seed/凭据来源，其余 seed 见下。
REDIS_MODE=standalone
REDIS_CLUSTER_SEEDS=

ARTIFACT_ROOT=./.data/artifacts
SKILL_CACHE_ROOT=./.data/skill-cache

# 用户 Skill 草稿（生产挂 muad-skill-drafts-rwx，只挂 Console）。
SKILL_DRAFT_ROOT=./.data/skill-drafts
# 草稿配额：总大小（MiB）、单文件大小与文件数上限。
SKILL_DRAFT_QUOTA_MIB=100
SKILL_DRAFT_FILE_MAX_BYTES=5242880
SKILL_DRAFT_FILE_LIMIT=2000
# SKILL_OUTPUT_DIR 产物登记边界：文件数、单文件与总大小（MiB）。
SKILL_OUTPUT_MAX_FILES=100
SKILL_OUTPUT_MAX_FILE_MIB=16
SKILL_OUTPUT_MAX_TOTAL_MIB=64

# Workspace（按 tenant + user + Agent 隔离）：生产挂 muad-workspaces-rwx。
WORKSPACE_ROOT=./.data/workspaces
# 单 workspace / 单用户聚合配额（MiB）与文件数上限。
WORKSPACE_QUOTA_MIB=500
WORKSPACE_USER_QUOTA_MIB=500
WORKSPACE_FILE_LIMIT=5000
# data 跨 Run 持久、outputs 每次执行独立；清理 TTL 按天。
WORKSPACE_OUTPUT_TTL_DAYS=30
WORKSPACE_DATA_TTL_DAYS=30

# Skill/Shell 沙箱：bwrap（生产默认）/ dev-unsafe（仅 ENV=dev，显式）/ disabled（仅 dev）。
# 非 dev 配置 dev-unsafe/disabled 会在启动期报错；生产必须保持 bwrap。
SANDBOX_MODE=bwrap
# bwrap 可执行文件路径；空 = 从 PATH 查找。
SANDBOX_BWRAP_PATH=
# 单次执行 /tmp tmpfs 上限（字节）。
SANDBOX_TMPFS_BYTES=67108864
# stdout/stderr 单流上限（字节）。
SANDBOX_OUTPUT_LIMIT_BYTES=65536

MIGRATIONS_DIR=./migrations/versions

CONSOLE_PLATFORM_URL=http://127.0.0.1:8000
AGENT_RUNTIME_URL=http://127.0.0.1:8001
AGENT_WORKER_URL=http://127.0.0.1:8002
IM_GATEWAY_URL=http://127.0.0.1:8003

# 内部服务身份与本地真实协议探针（默认空 = 关闭）。
INTERNAL_SERVICE_TOKEN=
CHANNEL_PROBE_URL=
WECOM_WS_URL=
WECOM_WS_CA_FILE=

# Run 租约 / 心跳 / 回收（秒）。
RUN_LEASE_SEC=60
RUN_HEARTBEAT_SEC=20
RUN_REAPER_INTERVAL_SEC=30
RUN_EVENT_HEARTBEAT_SEC=15

# Task 租约 / 心跳 / 取消检查与 Worker 轮询（秒）。
TASK_LEASE_SEC=60
TASK_HEARTBEAT_SEC=20
TASK_CANCEL_CHECK_SEC=2
WORKER_POLL_INTERVAL_SEC=5
# 批次并发**平台上限**：tasks 的业务并发不得超过它（服务资源预算，留在环境）。
BATCH_PLATFORM_LIMIT=16

# 调度器 / 投递轮询与批次规模。
SCHEDULER_POLL_INTERVAL_SEC=10
SCHEDULER_BATCH_SIZE=100
# 学习调度循环周期（秒）；租户是否学习由系统设置 learning_enabled 控制。
LEARNING_SCHEDULER_INTERVAL_SEC=60
TASK_DEADLINE_SWEEP_INTERVAL_SEC=30
DELIVERY_POLL_INTERVAL_SEC=5
DELIVERY_BATCH_SIZE=20

# 异步工具结果 / 控制发件 Dispatcher（技术参数：服务启动时冻结，模型不可设置；重启生效）。
ASYNC_TOOL_DISPATCH_TIMEOUT_SEC=5
ASYNC_TOOL_DISPATCH_LEASE_SEC=30
ASYNC_TOOL_DISPATCH_POLL_SEC=1
ASYNC_TOOL_DISPATCH_BATCH_SIZE=32
ASYNC_TOOL_DISPATCH_RETRY_BASE_SEC=1
ASYNC_TOOL_DISPATCH_RETRY_CAP_SEC=30
ASYNC_TOOL_DISPATCH_MAX_ATTEMPTS=20

# 每机器人状态刷新预算（正文/最终结果不占此额度）：服务资源预算上限，留在环境。
# （展示节拍 `im.progress_interval_sec` 已改为系统设置项，不再由环境注入。）
IM_PROGRESS_UPDATES_PER_SECOND=10

# 每进程执行槽和 Gateway 短受理队列；不按副本数扩张租户或模型供方额度。
RUNTIME_EXECUTION_CONCURRENCY=8
WORKER_EXECUTION_CONCURRENCY=4
GATEWAY_MAX_CONCURRENT_HANDLERS=8
GATEWAY_MAX_PENDING_HANDLERS=256
GATEWAY_MAX_PENDING_PER_ROUTE=8
GATEWAY_MAX_PENDING_COMMANDS=32
GATEWAY_MAX_SSE_SUBSCRIBERS=1100
RUNTIME_MAX_SSE_SUBSCRIBERS=1100
# Gateway 入口快照轮询周期（秒）：新增/停用入口在该节拍内传播。
BOT_SNAPSHOT_POLL_SEC=30

# Connector 抽取后的路由/入站面（WebChat 以外的通道由 Connector 持有传输）：
# - GATEWAY_ROUTED_CHANNELS：Gateway 只路由、不自带适配器的通道（逗号分隔，启用 Connector 时设 WECOM）
# - GATEWAY_WEBHOOK_CHANNELS：走 webhook adapter 的通道（验签后入 im.inbound）
# - DELIVERY_STREAM_WAIT_SEC：投递命令写入 im.outbound 后有界等待结果的上限（秒），超时回可重试错误
# - WEBHOOK_TIMESTAMP_TOLERANCE_SEC：webhook 时间戳允许的偏移窗口（秒），超出即拒收
GATEWAY_ROUTED_CHANNELS=
GATEWAY_WEBHOOK_CHANNELS=
DELIVERY_STREAM_WAIT_SEC=2.0
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

# Redis Stream 入站分片与保留（Connector/webhook 写入，Gateway 消费组读取）。
INBOUND_STREAM_SHARDS=32
INBOUND_STREAM_MAXLEN=5000
INBOUND_STREAM_LOST_AFTER_SEC=60
INBOUND_STREAM_RETENTION_SEC=600
OUTBOUND_STREAM_RETENTION_SEC=3600

# 每进程准入等待队列上限（超出显式拒绝，不无限排队）；0 表示不额外排队。
RUNTIME_ADMISSION_QUEUE_LIMIT=256

# 记忆巩固任务入队背压上限（与执行槽独立，避免后台任务挤占对话）。
MEMORY_CONSOLIDATION_QUEUE_MAX=10000

# 每进程 PG / Redis 资源；部署总量按进程数 × 最大副本数另行核算。
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SEC=5
REDIS_MAX_CONNECTIONS=50

# 短控制、SSE、模型、MCP、业务出站和上传分别占用独立 HTTP 池。
# keepalive 不得超过各自连接上限；MCP/业务请求在飞数独立约束 HTTP/2 并发。
CONTROL_HTTP_MAX_CONNECTIONS=32
CONTROL_HTTP_MAX_KEEPALIVE=16
STREAM_HTTP_MAX_CONNECTIONS=1100
STREAM_HTTP_MAX_KEEPALIVE=64
MODEL_HTTP_MAX_CONNECTIONS=64
MODEL_HTTP_MAX_KEEPALIVE=32
MCP_HTTP_MAX_CONNECTIONS=16
MCP_HTTP_MAX_KEEPALIVE=8
MCP_MAX_INFLIGHT=8
EGRESS_HTTP_MAX_CONNECTIONS=16
EGRESS_HTTP_MAX_KEEPALIVE=8
EGRESS_MAX_INFLIGHT=8
UPLOAD_HTTP_MAX_CONNECTIONS=8
UPLOAD_HTTP_MAX_KEEPALIVE=4
HTTP_CONNECT_TIMEOUT_SEC=5
HTTP_POOL_TIMEOUT_SEC=2
CONTROL_HTTP_READ_TIMEOUT_SEC=10
STREAM_HTTP_READ_TIMEOUT_SEC=45
MODEL_HTTP_READ_TIMEOUT_SEC=60
UPLOAD_HTTP_READ_TIMEOUT_SEC=60
MCP_HTTP_READ_TIMEOUT_SEC=30
EGRESS_HTTP_READ_TIMEOUT_SEC=30

# 共享事件追尾/批量持久化与 SSE 内存预算；读超时至少为事件心跳的 3 倍。
RUN_EVENT_FALLBACK_POLL_SEC=5
MODEL_CALL_LEASE_SEC=60
MODEL_CALL_HEARTBEAT_SEC=20
STREAM_DELTA_FLUSH_INTERVAL_MS=50
STREAM_DELTA_FLUSH_BYTES=4096
SSE_EVENT_MAX_BYTES=262144
SSE_SUBSCRIBER_BUFFER_BYTES=1048576
SSE_TOTAL_BUFFER_BYTES=67108864

# CHAT 认证复核、交换及请求硬预算；Token/会话 TTL 是系统设置，不在环境重复声明。
CHAT_AUTH_RECHECK_SEC=15
CHAT_EXCHANGE_MAX_BODY_BYTES=4096
CHAT_EXCHANGE_PER_IP_PER_MINUTE=6000
CHAT_MESSAGE_HARD_MAX_BYTES=1048576
CHAT_UPLOAD_HARD_MAX_BYTES=52428800

# 持久通道结果投递泵；单次 timeout < lease，重试只交付已保存的结果。
CHANNEL_DELIVERY_CONCURRENCY=4
CHANNEL_DELIVERY_TIMEOUT_SEC=5
CHANNEL_DELIVERY_LEASE_SEC=30
CHANNEL_DELIVERY_POLL_SEC=1
CHANNEL_DELIVERY_BATCH_SIZE=32
CHANNEL_DELIVERY_RETRY_BASE_SEC=1
CHANNEL_DELIVERY_RETRY_CAP_SEC=30
CHANNEL_DELIVERY_MAX_ATTEMPTS=20
