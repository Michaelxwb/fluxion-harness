# Local dev defaults (ADR-A007 PG-Only)
FLUXION_ENV=dev
FLUXION_DATABASE_URL=postgresql+asyncpg://mmuser:mmuser@localhost:5432/fluxion
# Generate a 32-byte random key and provide it outside source control.
FLUXION_MASTER_KEY=
FLUXION_LOG_LEVEL=INFO

