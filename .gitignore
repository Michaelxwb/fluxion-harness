__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
node_modules/
dist/
.env
.data/
*.log
.idea/
.vscode/
.DS_Store

# code-flow runtime state (local only)
.code-flow/process/
.code-flow/worktrees/
e2e/test-results/
e2e/playwright-report/

# Intranet base-image source archives (offline builds)
build/docker-build/base/vendor/*
!build/docker-build/base/vendor/.gitkeep
!build/docker-build/base/vendor/README.md

# Skill 导入包是构建产物（./skills/package.sh 生成），不进版本库
skills/*.zip

# code-flow machine-specific launcher entries (generated by init)
.code-flow/launcher/hook.sh
.code-flow/launcher/hook.cmd
.code-flow/launcher/hook.ps1
.opencode/plugins/code-flow/index.js
