# syntax=docker/dockerfile:1
# Python 3.12 runtime base for console-platform / im-gateway / im-connector.
#
# This image intentionally contains only runtime + build-time Python tooling.
# Application dependencies are installed by each service image with
# `pip install -r requirements/<service>.txt`, matching the intranet CI flow.
ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=60 \
    PIP_RETRIES=5 \
    TZ=Asia/Shanghai

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      tzdata \
 && rm -rf /var/lib/apt/lists/* \
 && python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
 && groupadd --gid 10001 muad \
 && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin muad

USER 10001:10001
WORKDIR /app
