# syntax=docker/dockerfile:1
# Intranet service image: agent-worker.
# Node.js 24 is required for JavaScript skills; it comes from the Node base image.
ARG BASE_IMAGE=docker.sangfor.com/mss-base/python-node:3.12.13-node24
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG SKILL_DEPS_SHA256=unknown
LABEL org.muad.base-image="${BASE_IMAGE}"
LABEL org.muad.skill-deps.sha256="${SKILL_DEPS_SHA256}"

ARG PIP_INDEX_URL=http://mirrors.sangfor.org/pypi/simple
ARG PIP_TRUSTED_HOST=mirrors.sangfor.org
ARG NPM_REGISTRY=http://npm.uedc.sangfor.com.cn/
USER root
WORKDIR /app

COPY requirements.txt /tmp/requirements.txt
COPY build/docker-build/skill-deps /tmp/skill-deps
RUN python -m pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
      --trusted-host "${PIP_TRUSTED_HOST}" -r /tmp/requirements.txt \
 && PIP_INDEX_URL="${PIP_INDEX_URL}" PIP_TRUSTED_HOST="${PIP_TRUSTED_HOST}" \
      NPM_REGISTRY="${NPM_REGISTRY}" sh /tmp/skill-deps/install.sh /tmp/skill-deps \
 && rm -rf /tmp/skill-deps

COPY config /app/config
# Startup validation reads the alembic head from ./migrations/versions and
# refuses to boot without it (muad_api.startup.validate_startup).
COPY migrations /app/migrations
COPY packages /app/packages
COPY apps/agent-worker /app/apps/agent-worker

RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation \
      /app/packages/* \
      /app/apps/agent-worker \
 && chown -R 10001:10001 /app

USER 10001:10001
EXPOSE 8002
CMD ["uvicorn", "muad_agent_worker.main:app", "--host", "0.0.0.0", "--port", "8002"]
