# syntax=docker/dockerfile:1
# Python 3.12.13 base on the intranet PlatOS python:3.11.2 image.
#
# The intranet image is PlatOS 1.3 (glibc 2.28, OpenSSL 1.1.1f) with Python
# 3.11.2 under /opt/sangfor/python. It has no gcc/make and no apt/dnf/yum, so
# compiling Python 3.12.13 inside it is not possible.
#
# Instead we install the relocatable python-build-standalone 3.12.13 build:
#   - built against glibc 2.17, so it runs on PlatOS glibc 2.28
#   - bundles OpenSSL, sqlite, libffi, lzma, bz2 and zlib
#   - does not need gcc or any OS package manager
#
# Offline builds: put the archive (and optional setuptools/wheel wheels) in
# ./vendor/ next to this Dockerfile.
ARG BASE_IMAGE=docker.sangfor.com/mss-base/python:3.11.2

FROM ${BASE_IMAGE}

ARG PYTHON_VERSION=3.12.13
ARG PYTHON_STANDALONE_TAG=20260325
ARG PYTHON_STANDALONE_URL=https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_STANDALONE_TAG}/cpython-${PYTHON_VERSION}%2B${PYTHON_STANDALONE_TAG}-x86_64-unknown-linux-gnu-install_only.tar.gz
ARG PIP_INDEX_URL=http://mirrors.sangfor.org/pypi/simple
ARG PIP_TRUSTED_HOST=mirrors.sangfor.org

USER root
ENV PATH=/opt/python3.12/bin:${PATH} \
    PYTHON_VERSION=3.12.13 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=60 \
    PIP_RETRIES=5 \
    TZ=Asia/Shanghai

COPY extract.py /tmp/extract.py
COPY vendor/ /tmp/python-vendor/

RUN set -eux; \
    tarball="/tmp/python-vendor/cpython-${PYTHON_VERSION}+${PYTHON_STANDALONE_TAG}-x86_64-unknown-linux-gnu-install_only.tar.gz"; \
    if [ ! -f "${tarball}" ]; then \
      tarball="/tmp/python-standalone.tar.gz"; \
      if command -v curl >/dev/null 2>&1; then \
        curl -fsSL "${PYTHON_STANDALONE_URL}" -o "${tarball}"; \
      elif command -v wget >/dev/null 2>&1; then \
        wget -q "${PYTHON_STANDALONE_URL}" -O "${tarball}"; \
      else \
        python -c 'import urllib.request,sys; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])' \
          "${PYTHON_STANDALONE_URL}" "${tarball}"; \
      fi; \
    fi; \
    mkdir -p /opt/python3.12; \
    python /tmp/extract.py "${tarball}" /opt/python3.12 1; \
    rm -f /tmp/python-standalone.tar.gz; \
    /opt/python3.12/bin/python3.12 --version; \
    /opt/python3.12/bin/python3.12 -m pip --version; \
    if ls /tmp/python-vendor/setuptools-*.whl >/dev/null 2>&1 \
       && ls /tmp/python-vendor/wheel-*.whl >/dev/null 2>&1; then \
      /opt/python3.12/bin/python3.12 -m pip install --no-index --find-links /tmp/python-vendor \
        setuptools wheel; \
    else \
      /opt/python3.12/bin/python3.12 -m pip install --no-cache-dir \
        -i "${PIP_INDEX_URL}" --trusted-host "${PIP_TRUSTED_HOST}" \
        setuptools wheel; \
    fi; \
    rm -rf /tmp/python-vendor /tmp/extract.py; \
    ln -sf /opt/python3.12/bin/python3.12 /usr/local/bin/python3.12; \
    ln -sf /opt/python3.12/bin/python3.12 /usr/local/bin/python3; \
    ln -sf /opt/python3.12/bin/python3.12 /usr/local/bin/python; \
    ln -sf /opt/python3.12/bin/pip3.12 /usr/local/bin/pip3.12; \
    ln -sf /opt/python3.12/bin/pip3.12 /usr/local/bin/pip3; \
    ln -sf /opt/python3.12/bin/pip3.12 /usr/local/bin/pip; \
    if ! grep -q '^muad:' /etc/group; then echo 'muad:x:10001:' >> /etc/group; fi; \
    if ! grep -q '^muad:' /etc/passwd; then \
      echo 'muad:x:10001:10001::/app:/bin/false' >> /etc/passwd; \
    fi; \
    python --version; \
    python -m pip --version; \
    python -c 'import ssl, sqlite3, zlib, bz2, lzma, ctypes; print("python modules ok")'

USER 10001:10001
WORKDIR /app
