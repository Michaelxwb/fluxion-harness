# syntax=docker/dockerfile:1
# Intranet service image: agent-worker.
# Node.js 24 is required for JavaScript skills; it comes from the Node base image.
ARG BASE_IMAGE=docker.sangfor.com/mss-base/muad-python-node-base:3.12-node24
FROM ${BASE_IMAGE}

ARG PIP_INDEX_URL=http://mirrors.sangfor.org/pypi/simple
ARG PIP_TRUSTED_HOST=mirrors.sangfor.org
USER root
WORKDIR /app

COPY build/requirements/agent-worker.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -i "${PIP_INDEX_URL}" \
      --trusted-host "${PIP_TRUSTED_HOST}" -r /tmp/requirements.txt

COPY config /app/config
COPY packages /app/packages
COPY apps/agent-worker /app/apps/agent-worker

RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation \
      /app/packages/* \
      /app/apps/agent-worker \
 && chown -R 10001:10001 /app

USER 10001:10001
EXPOSE 8002
CMD ["uvicorn", "muad_agent_worker.main:app", "--host", "0.0.0.0", "--port", "8002"]
