# syntax=docker/dockerfile:1
# Fallback: copy a glibc-compatible nginx installation from an existing image.
# Use only when the PlatOS/Kylin base has no nginx RPM or package manager.
#
# NGINX_SOURCE_IMAGE must be built for a glibc version <= the target base
# (for example the existing portal-nginx image, if it already runs on this base).
ARG BASE_IMAGE=docker.sangfor.com/mss-base/platos-kylin:1.3.2
ARG NGINX_SOURCE_IMAGE=nginx:1.24-bullseye

FROM ${NGINX_SOURCE_IMAGE} AS nginx-src
RUN set -eux; \
    mkdir -p /opt/nginx-libs; \
    for lib in libpcre2-8.so.0 libpcre.so.3 libcrypt.so.1 libssl.so.1.1 libcrypto.so.1.1 libz.so.1 libprofiler.so.0 libunwind.so.8; do \
      src="$(find /usr/lib /lib -name "$lib" 2>/dev/null | head -1)"; \
      if [ -n "$src" ]; then cp -L "$src" /opt/nginx-libs/; fi; \
    done

FROM ${BASE_IMAGE}
USER root

COPY --from=nginx-src /usr/sbin/nginx /usr/sbin/nginx
COPY --from=nginx-src /usr/lib/nginx /usr/lib/nginx
COPY --from=nginx-src /etc/nginx /etc/nginx
COPY --from=nginx-src /usr/share/nginx /usr/share/nginx
COPY --from=nginx-src /opt/nginx-libs /opt/nginx/lib
COPY nginx.conf /etc/nginx/nginx.conf

ENV LD_LIBRARY_PATH=/opt/nginx/lib

RUN set -eux; \
    if ! getent passwd nginx >/dev/null 2>&1; then \
      echo 'nginx:x:10001:10001::/nonexistent:/bin/false' >> /etc/passwd; \
    fi; \
    if ! getent group nginx >/dev/null 2>&1; then \
      echo 'nginx:x:10001:' >> /etc/group; \
    fi; \
    mkdir -p /var/log/nginx /var/cache/nginx /tmp/nginx/client_temp /tmp/nginx/proxy_temp /tmp/nginx/fastcgi_temp /tmp/nginx/uwsgi_temp /tmp/nginx/scgi_temp; \
    chown -R 10001:10001 /var/log/nginx /var/cache/nginx /tmp/nginx; \
    sed -e 's#server muad-console-platform:8000#server 127.0.0.1:8000#' \
        -e 's#server muad-im-gateway:8003#server 127.0.0.1:8003#' \
        /etc/nginx/nginx.conf > /tmp/nginx-test.conf; \
    nginx -t -c /tmp/nginx-test.conf; \
    rm -f /tmp/nginx-test.conf /tmp/nginx.pid /var/log/nginx/error.log /var/log/nginx/access.log; \
    chown -R 10001:10001 /var/log/nginx /var/cache/nginx /tmp/nginx

USER 10001:10001
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
