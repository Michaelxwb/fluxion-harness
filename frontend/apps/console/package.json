{
  "name": "@fluxion/console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../../scripts/check-no-inmemory.mjs && node ../../scripts/check-semi-compliance.mjs && tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ../../scripts/check-semi-compliance.mjs && pnpm run lint && node ../../scripts/check-no-bare-fetch.mjs && node ../../scripts/check-directory-structure.mjs && node ../../scripts/check-ts-hygiene.mjs && node scripts/run-vitest.mjs"
  },
  "dependencies": {
    "@fluxion/shared": "workspace:*",
    "@douyinfe/semi-icons": "^2.102.0",
    "@douyinfe/semi-ui": "^2.102.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@eslint/js": "^9.34.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.34.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
