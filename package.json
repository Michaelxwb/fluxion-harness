{
  "name": "fluxion-harness",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev:console": "pnpm --filter @fluxion/console dev",
    "dev:chat": "pnpm --filter @fluxion/chat dev",
    "build": "node frontend/scripts/check-no-inmemory.mjs && pnpm --filter @fluxion/shared typecheck && pnpm --filter @fluxion/console build && pnpm --filter @fluxion/chat build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.55.0",
    "typescript": "^5.9.0"
  }
}
